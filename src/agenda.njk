---
layout: base.njk
title: "Agenda - Elzemieke Janzen"
description: "Wat ik begeleid: losse yogasessies, mini-retraites en trajecten, met data en locaties."
---

<section class="page-head wrap">
  <p class="eyebrow" style="justify-content:center">Agenda</p>
  <h1>Agenda</h1>
  <p class="sub">Wat ik begeleid, van losse yogasessies tot mini-retraites en trajecten. Kies wat je zoekt.</p>
</section>

<section class="section">
  <div class="wrap agenda">
    <div class="agenda__filters" role="group" aria-label="Filter de agenda">
      <button type="button" class="agenda__chip is-active" data-filter="alles">Alles</button>
      <button type="button" class="agenda__chip" data-filter="sessie">Losse sessies</button>
      <button type="button" class="agenda__chip" data-filter="retraite">Mini-retraites</button>
      <button type="button" class="agenda__chip" data-filter="traject">Trajecten</button>
    </div>
    <p class="agenda__uitleg" id="agenda-uitleg">Alles bij elkaar, op datum.</p>

    <div class="agenda__lijst">
      {% for item in agenda %}
      <article class="agenda-rij" data-type="{{ item.type }}"{% if item.datum %} data-datum="{{ item.datum }}"{% endif %}>
        <div class="agenda-rij__datum">
          {% if item.datum %}
          <b>{{ item.dag }}</b><span>{{ item.maand }}</span>
          {% else %}
          <span class="agenda-rij__wanneer">{{ item.wanneer }}</span>
          {% endif %}
        </div>
        <div class="agenda-rij__tekst">
          <span class="agenda-rij__label agenda-rij__label--{{ item.type }}">{% if item.label %}{{ item.label }}{% elif item.type == "sessie" %}Losse sessie{% elif item.type == "retraite" %}Mini-retraite{% else %}Traject{% endif %}</span>
          <h3>{{ item.titel }}</h3>
          <p class="agenda-rij__meta">{% if item.datum %}{{ item.weekdag }} {{ item.dag }} {{ item.maand }} · {% if item.tijd %}{{ item.tijd }} · {% endif %}{% endif %}{{ item.plek }}{% if item.tarief %} · {{ item.tarief }}{% endif %}{% if item.beschikbaarheid %} · {{ item.beschikbaarheid }}{% endif %}</p>
          <p>{{ item.omschrijving }}</p>
        </div>
        <a class="agenda-rij__link" href="{{ item.link }}"{% if item.extern %} target="_blank" rel="noopener"{% endif %}>{{ item.linkTekst }} →</a>
      </article>
      {% endfor %}
    </div>

    <p style="text-align:center; margin-top:2.5rem"><a href="/producten/">Liever eerst zelf aan de slag? Bekijk de audio's →</a></p>
  </div>
</section>

<script>
(function () {
  var uitleg = {
    alles: "Alles bij elkaar, op datum.",
    sessie: "Losse sessies en praktijkdagen: voor een enkele keer, zonder verplichting voor daarna.",
    retraite: "Mini-retraites: een weekend bij Nala Village, met workshops rond een thema. Je boekt zelf je verblijf.",
    traject: "Trajecten: begeleiding van zes maanden, die begint met een gratis kennismaking."
  };
  var vandaag = new Date();
  var iso = vandaag.getFullYear() + "-" + String(vandaag.getMonth() + 1).padStart(2, "0") + "-" + String(vandaag.getDate()).padStart(2, "0");
  var rijen = document.querySelectorAll(".agenda-rij");
  rijen.forEach(function (r) { if (r.dataset.datum && r.dataset.datum < iso) r.remove(); });
  var chips = document.querySelectorAll(".agenda__chip");
  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      var f = chip.dataset.filter;
      chips.forEach(function (c) { c.classList.toggle("is-active", c === chip); });
      document.querySelectorAll(".agenda-rij").forEach(function (r) {
        r.hidden = !(f === "alles" || r.dataset.type === f);
      });
      document.getElementById("agenda-uitleg").textContent = uitleg[f];
    });
  });
})();
</script>
