<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Elzemieke Janzen — Connect to Center" }}</title>
  <meta name="description" content="{{ description or 'Lichaamsgerichte therapie, transformationeel lichaamswerk en systemische coaching. Een veilige bedding waarin je dieper in jezelf kunt zakken en je lijf weer gaat spreken.' }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="https://elzemiekejanzen.nl{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Connect to Center">
  <meta property="og:title" content="{{ title or 'Elzemieke Janzen — Connect to Center' }}">
  <meta property="og:description" content="{{ description or 'Lichaamsgerichte therapie, transformationeel lichaamswerk en systemische coaching. Een veilige bedding waarin je dieper in jezelf kunt zakken en je lijf weer gaat spreken.' }}">
  <meta property="og:url" content="https://elzemiekejanzen.nl{{ page.url }}">
  <meta property="og:image" content="https://elzemiekejanzen.nl/images/hero-sfeerbeeld.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or 'Elzemieke Janzen — Connect to Center' }}">
  <meta name="twitter:description" content="{{ description or 'Lichaamsgerichte therapie, transformationeel lichaamswerk en systemische coaching. Een veilige bedding waarin je dieper in jezelf kunt zakken en je lijf weer gaat spreken.' }}">
  <meta name="twitter:image" content="https://elzemiekejanzen.nl/images/hero-sfeerbeeld.jpg">
  <link rel="icon" href="/images/symbool.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Mulish:ital,wght@0,300..800;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={% buildTime %}">
</head>
<body>
  <header class="site-header">
    <div class="bar wrap">
      <a class="brand" href="/">
        <img class="brand__mark" src="/images/symbool.svg" alt="" width="40" height="40">
        <span class="brand__text">
          <span class="brand__name">Elzemieke Janzen</span>
          <span class="brand__sub">Connect to Center</span>
        </span>
      </a>
      <input type="checkbox" id="navtoggle" class="navtoggle" hidden>
      <label for="navtoggle" class="hamburger" aria-label="Menu openen"><span></span><span></span><span></span></label>
      <nav class="nav" aria-label="Hoofdmenu">
        <div class="nav__item nav__item--dropdown">
          <a href="/#aanbod">Aanbod</a>
          <div class="nav__dropdown">
            <a href="/#aanbod">1-op-1 begeleiding</a>
            <a href="/producten/">Zelf aan de slag</a>
            <a href="/bedrijven/">Bedrijven &amp; teams</a>
            <a href="/tarieven/">Tarieven</a>
          </div>
        </div>
        <div class="nav__item nav__item--dropdown">
          <a href="/#over-mij">Over mij</a>
          <div class="nav__dropdown">
            <a href="/#over-mij">Wie ik ben</a>
            <a href="/#methode">Hoe ik werk</a>
          </div>
        </div>
        <a href="/#ervaringen">Klantervaringen</a>
        <a href="/#contact">Contact</a>
        <a href="/gratis-tools/">Gratis tools</a>
        <a class="nav__cta" href="/#boeking">Plan een kennismaking</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <div class="foot__brand">
        <img src="/images/symbool.svg" alt="" width="48" height="48">
        <div>
          <span class="foot__name">Elzemieke Janzen · Connect to Center</span>
          <p>Lichaamsgerichte therapie, transformationeel lichaamswerk &amp; systemische coaching</p>
        </div>
      </div>
      <div class="foot__contact">
        <a href="/#aanbod">1-op-1 begeleiding</a>
        <a href="/bedrijven/">Bedrijven &amp; teams</a>
        <a href="/producten/">Zelf aan de slag</a>
      </div>
      <div class="foot__social">
        <a href="https://www.instagram.com/elzemieke.janzen" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/elzemiekejanzen" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM2.98 9.5h4v12h-4v-12ZM9.98 9.5h3.83v1.64h.05c.53-1 1.85-2.05 3.8-2.05 4.07 0 4.82 2.68 4.82 6.17v6.24h-4v-5.53c0-1.32-.02-3.02-1.84-3.02-1.84 0-2.12 1.44-2.12 2.92v5.63h-4v-12Z"/></svg>
        </a>
        <a href="mailto:connect@elzemiekejanzen.com" aria-label="E-mail">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
        </a>
      </div>
      <div class="foot__keurmerk">
        <p style="font-size:0.85rem; color:var(--parel-zacht); margin:0 0 0.5rem">Ik ben aangesloten bij de brancheorganisatie</p>
        <img src="/images/logo-vbag.png" alt="Aangesloten bij VBAG" height="40">
      </div>
    </div>
    <div class="wrap foot__base">
      <span>© {% year %} Elzemieke Janzen · Connect to Center</span>
      <span class="foot__legal">
        <a href="/voorwaarden/">Algemene voorwaarden</a>
        <a href="/privacybeleid/">Privacybeleid</a>
      </span>
    </div>
  </footer>

  <div class="cookiebar" id="cookiebar" hidden>
    <p>Fijn dat je er bent! Ik gebruik hier alleen de minimale cookies: voor je voorkeuren en om (volledig geanonimiseerd) bij te houden wat wel en niet landt. Verkopen of delen met anderen doe ik niet — jouw gegevens blijven van jou. Meer weten? Lees mijn <a href="/privacybeleid/">privacybeleid</a>.</p>

    <div class="cookiebar__prefs" id="cookie-prefs" hidden>
      <div class="cookiebar__pref">
        <span><strong>Noodzakelijk</strong> — nodig om de site te laten werken.</span>
        <span class="cookiebar__locked">Altijd aan</span>
      </div>
      <label class="cookiebar__pref cookiebar__pref--toggle">
        <span><strong>Statistieken</strong> — Google Analytics, volledig geanonimiseerd.</span>
        <input type="checkbox" id="pref-analytics">
      </label>
      <label class="cookiebar__pref cookiebar__pref--toggle">
        <span><strong>Boekingswidget</strong> — Calendly, om direct op de site een afspraak te plannen.</span>
        <input type="checkbox" id="pref-calendly">
      </label>
    </div>

    <div class="cookiebar__actions" id="cookie-actions-main">
      <button class="btn" type="button" id="cookie-accept-all">Accepteren</button>
      <button class="btn btn--ghost" type="button" id="cookie-customize">Zelf instellen</button>
    </div>
    <div class="cookiebar__actions" id="cookie-actions-prefs" hidden>
      <button class="btn" type="button" id="cookie-save-prefs">Voorkeuren opslaan</button>
    </div>
  </div>

  <script>
    (function () {
      var GA_ID = "G-5GVEBCQ3YR";
      var STORAGE_KEY = "cookie-prefs";

      function loadAnalytics() {
        if (GA_ID.indexOf("G-XXX") === 0) return; // placeholder: nog geen GA laden
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });
      }

      function loadCalendly() {
        var widget = document.querySelector(".calendly-inline-widget");
        if (!widget || widget.dataset.loaded) return;
        widget.dataset.loaded = "1";
        widget.hidden = false;
        var msg = document.getElementById("calendly-msg");
        if (msg) msg.hidden = true;
        var s = document.createElement("script");
        s.src = "https://assets.calendly.com/assets/external/widget.js";
        s.async = true;
        document.body.appendChild(s);
      }

      function applyPrefs(prefs) {
        if (prefs.analytics) loadAnalytics();
        if (prefs.calendly) loadCalendly();
      }

      function getStoredPrefs() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (raw) return JSON.parse(raw);
        } catch (e) {}
        if (localStorage.getItem("cookie-consent") === "granted") {
          return { analytics: true, calendly: true }; // migratie oude alles-of-niets keuze
        }
        return null;
      }

      function savePrefs(prefs) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
      }

      var bar = document.getElementById("cookiebar");
      var stored = getStoredPrefs();

      if (stored) {
        applyPrefs(stored);
      } else {
        bar.hidden = false;
      }

      document.getElementById("cookie-accept-all").addEventListener("click", function () {
        var prefs = { analytics: true, calendly: true };
        savePrefs(prefs);
        applyPrefs(prefs);
        bar.hidden = true;
      });

      document.getElementById("cookie-customize").addEventListener("click", function () {
        document.getElementById("cookie-prefs").hidden = false;
        document.getElementById("cookie-actions-main").hidden = true;
        document.getElementById("cookie-actions-prefs").hidden = false;
      });

      document.getElementById("cookie-save-prefs").addEventListener("click", function () {
        var prefs = {
          analytics: document.getElementById("pref-analytics").checked,
          calendly: document.getElementById("pref-calendly").checked
        };
        savePrefs(prefs);
        applyPrefs(prefs);
        bar.hidden = true;
      });
    })();
  </script>
</body>
</html>
