<!-- ===================== OVER MIJ ===================== -->
<section class="section section--soft" id="over-mij">
  <div class="wrap overmij">
    <div class="overmij__media">
      <img class="ph--portrait overmij__photo" src="/images/over-mij-portret.jpg" alt="Portret van Elzemieke Janzen" width="900" height="1200">
